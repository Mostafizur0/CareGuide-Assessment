# Template for the Grafana admin password secret.
#
# Rotate the real secret with:
#   openssl rand -base64 24 | tr -d '\n' > secrets/grafana_admin_password.txt
#
# The file must contain the password only — no trailing key=value pairs.
# Grafana reads it through GF_SECURITY_ADMIN_PASSWORD__FILE, mounted by
# Docker Compose from secrets/grafana_admin_password.txt.
